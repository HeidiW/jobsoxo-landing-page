# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never expose this in client code or a PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (domain jobsoxo.com must be verified to send from hello@jobsoxo.com)
RESEND_API_KEY=

# Optional: where to send a "new signup" notification
WAITLIST_NOTIFY_EMAIL=

# Optional: Plausible site domain (defaults to jobsoxo.com)
PUBLIC_PLAUSIBLE_DOMAIN=jobsoxo.com

# Optional: override the Google Analytics 4 measurement ID (default G-64Z1WC2M9S, in src/lib/analytics.ts).
# Set to "off" to disable Google Analytics and the cookie banner.
PUBLIC_GA_MEASUREMENT_ID=
