---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import HardHat from '@lucide/astro/icons/hard-hat';
import Photo from './Photo.astro';

interface Props {
  /** "photo" (default) = owner photo + green card; "app" = dashboard screenshot in a green panel. */
  layout?: 'photo' | 'app';
}

const { layout = 'photo' } = Astro.props;
---

<section id="top" class="container hero">
  <div class="intro">
    <div class="eyebrow"><span class="dot"></span>Built by a contractor, for small construction businesses</div>
    <h1><span class="accent">Price it.</span> Run it. Get paid.</h1>
    <p class="subhead">
      One simple app to price jobs, send invoices, pay your crew and keep track of change orders. Nothing else.
    </p>
    <div class="actions">
      <a href="#join" class="btn btn-primary">JOIN THE WAITLIST<ArrowRight size={18} /></a>
      <a href="#what" class="btn btn-outline">See what it does</a>
    </div>
  </div>

  {
    layout === 'photo' ? (
      <div class="media">
        <Photo
          class="hero-photo"
          src="/job-site.jpg"
          alt="An interior job site in progress: taped drywall, a scissor lift and stacked boards, with the city skyline through the windows"
          placeholder="Photo placeholder: owner on a job site"
          eager
        />
        <div class="card">
          <HardHat size={44} />
          <div class="card-text">
            <p class="card-title">Made for the owner who's on site all day.</p>
            <p class="card-body">Big buttons, plain words, and nothing you have to learn twice.</p>
          </div>
        </div>
      </div>
    ) : (
      <div class="app-panel">
        <div class="app-frame">
          <img src="/app-dashboard.png" alt="JobsOxo dashboard" />
        </div>
      </div>
    )
  }
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: var(--pad-y);
    padding-bottom: 40px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1100px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 14px var(--font-body);
    color: var(--green-ink);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 9px;
    background: var(--green);
  }

  h1 {
    font: 700 clamp(52px, 9vw, 128px) / 0.92 var(--font-display);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .accent {
    color: var(--green);
  }

  .subhead {
    max-width: 640px;
    font: 400 clamp(18px, 2vw, 22px) / 1.5 var(--font-body);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .media {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 20px;
  }

  :global(.hero-photo) {
    min-height: clamp(280px, 40vw, 520px);
    background: var(--green-tint);
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 28px;
    background: var(--green);
    color: #fff;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card-title {
    font: 700 clamp(26px, 2.6vw, 36px) / 1.05 var(--font-display);
    letter-spacing: -0.04em;
  }

  .card-body {
    font: 400 16px/1.5 var(--font-body);
    opacity: 0.9;
  }

  .app-panel {
    overflow: hidden;
    padding: clamp(20px, 4vw, 56px) clamp(20px, 4vw, 56px) 0;
    border-radius: 28px;
    background: var(--green);
  }

  .app-frame {
    overflow: hidden;
    border-radius: 16px 16px 0 0;
    background: #fff;
    box-shadow: var(--shadow-hero-shot);
  }

  .app-frame img {
    width: 100%;
  }

  @media (max-width: 760px) {
    .media {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
