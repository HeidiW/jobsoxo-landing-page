---
import X from '@lucide/astro/icons/x';

const nots = [
  { no: 'CRM & marketing', why: 'Your clients already know where to find you.' },
  { no: 'Inventory management', why: 'Log what you bought for a job. That’s it.' },
  { no: 'Project management boards', why: 'A job list and a schedule. No sticky notes.' },
  { no: 'Forty-tab dashboards', why: 'One screen that tells you who owes you money.' },
];
---

<section class="band">
  <div class="container inner">
    <h2>Nothing else. <span class="muted">On purpose.</span></h2>
    <ul class="cards">
      {
        nots.map(({ no, why }) => (
          <li class="card">
            <div class="head">
              <X size={20} class="x" />
              <span class="no">
                <span class="visually-hidden">Not included: </span>
                {no}
              </span>
            </div>
            <span class="why">{why}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    background: var(--surface);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: var(--pad-y-lg);
    padding-bottom: var(--pad-y-lg);
  }

  h2 {
    max-width: 1000px;
    font: 700 clamp(44px, 7vw, 96px) / 0.92 var(--font-display);
    letter-spacing: -0.055em;
  }

  .muted {
    color: var(--ink-3);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: 20px;
    background: var(--card);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .head :global(.x) {
    color: var(--orange);
  }

  .no {
    font: 600 17px var(--font-display);
    color: var(--ink-2);
    text-decoration: line-through;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
  }

  .why {
    font: 400 15px/1.5 var(--font-body);
    color: var(--ink-2);
  }
</style>
