---
interface Props {
  gaId: string;
}

const { gaId } = Astro.props;
// Only production builds actually load Google Analytics; dev still shows the banner so it can be tested.
const loadGa = import.meta.env.PROD;
---

<div class="consent" role="region" aria-label="Cookie consent" data-ga-id={gaId} data-load-ga={loadGa ? 'true' : 'false'} hidden>
  <p>
    We use Google Analytics cookies to see how people find and use this site. It's off unless you accept.
    <a href="/privacy">Privacy Policy</a>
  </p>
  <div class="actions">
    <button type="button" class="choice decline" data-choice="denied">Decline</button>
    <button type="button" class="choice accept" data-choice="granted">Accept</button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    max-width: 560px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow-shot);
  }

  p {
    flex: 1 1 280px;
    font: 400 14px/1.5 var(--font-body);
    color: var(--ink-2);
  }

  p a {
    color: var(--green-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  .choice {
    padding: 10px 18px;
    border-radius: 999px;
    font: 600 14px var(--font-body);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .decline {
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
  }

  .decline:hover {
    background: var(--surface);
  }

  .accept {
    border: 1.5px solid var(--green);
    background: var(--green);
    color: #fff;
  }

  .accept:hover {
    border-color: var(--green-hover);
    background: var(--green-hover);
  }
</style>

<script>
  type Choice = 'granted' | 'denied';

  const STORAGE_KEY = 'jobsoxo-cookie-consent';
  const banner = document.querySelector<HTMLElement>('.consent')!;
  const gaId = banner.dataset.gaId!;
  const loadGa = banner.dataset.loadGa === 'true';

  function readChoice(): Choice | null {
    try {
      const v = localStorage.getItem(STORAGE_KEY);
      return v === 'granted' || v === 'denied' ? v : null;
    } catch {
      return null;
    }
  }

  function saveChoice(choice: Choice | null) {
    try {
      if (choice) localStorage.setItem(STORAGE_KEY, choice);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Storage blocked (private mode etc.) — the choice just won't persist.
    }
  }

  function startGoogleAnalytics() {
    (window as any)[`ga-disable-${gaId}`] = false;
    if (!loadGa || window.gtag) return;
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      // gtag expects the raw arguments object, not an array.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('js', new Date());
    w.gtag('config', gaId);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);
  }

  function stopGoogleAnalytics() {
    // Stops further hits on this page if GA was already running; it won't load on later visits.
    (window as any)[`ga-disable-${gaId}`] = true;
  }

  const choice = readChoice();
  if (choice === 'granted') startGoogleAnalytics();
  else if (choice === null) banner.hidden = false;

  banner.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-choice]');
    if (!button) return;
    const picked = button.dataset.choice as Choice;
    saveChoice(picked);
    banner.hidden = true;
    if (picked === 'granted') startGoogleAnalytics();
    else stopGoogleAnalytics();
  });

  // "Cookie settings" link in the footer reopens the banner.
  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('[data-cookie-settings]')) return;
    banner.hidden = false;
    banner.querySelector<HTMLButtonElement>('.accept')!.focus();
  });
</script>
