---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Features from '../components/Features.astro';
import BuiltInTheTrade from '../components/BuiltInTheTrade.astro';
import NothingElse from '../components/NothingElse.astro';
import Waitlist from '../components/Waitlist.astro';
import Questions from '../components/Questions.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="JobsOxo — Price, manage, and get paid"
  description="One simple app to price jobs, send invoices, pay your crew and keep track of change orders. Nothing else."
>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <Features />
    <BuiltInTheTrade />
    <NothingElse />
    <Waitlist />
    <Questions />
  </main>
  <Footer />
</Base>
